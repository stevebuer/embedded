{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32VL",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/blinky.elf",
            "device": "STM32F100RB",
            "interface": "swd",
            "runToEntryPoint": true,
            "configFiles": [
                "interface/stlink-v1.cfg",
                "target/stm32f1x.cfg"
            ],
            "gdbPath": "gdb-multiarch",
            "svdFile": "${workspaceRoot}/STM32F100.svd"
        }
    ]
}
